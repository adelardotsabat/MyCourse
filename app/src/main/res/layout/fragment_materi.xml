<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MateriFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/CustomTextView18Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Daftar Materi Praktikum" />

        <!-- Item 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:text="1. Pengenalan Kotlin Dasar dan Android Studio"
            android:textStyle="bold" />

        <!-- Item 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:text="2. LinearLayout"
            android:textStyle="bold" />

        <!-- Item 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:text="3. RelativeLayout"
            android:textStyle="bold" />

        <!-- Item 4 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:text="4. ConstrainLayout"
            android:textStyle="bold" />

        <!-- Item 5 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:text="5. Activity dan Intent"
            android:textStyle="bold" />

        <!-- Item 6 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:text="6. UI Component"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:text="7. Style, Option Menu dan Tabs Layout"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>