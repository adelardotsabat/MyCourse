<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Tanpa ActionBar bawaan) -->
    <style name="Base.Theme.MyCourse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- kustomisasi warna utama di sini -->
        <item name="colorPrimary">@color/purple_500</item>
    </style>

    <!-- Base application theme DENGAN ActionBar -->
    <style name="Base.Theme.MyCourse.WithActionBar" parent="Theme.Material3.DayNight">
        <!-- kustomisasi tema dengan ActionBar di sini -->
        <item name="colorPrimary">@color/purple_500</item>
    </style>

    <!-- Theme alias yang dipanggil di AndroidManifest.xml -->
    <style name="Theme.MyCourse" parent="Base.Theme.MyCourse" />
    <style name="Theme.MyCourse.WithActionBar" parent="Base.Theme.MyCourse.WithActionBar" />
</resources>